# Local session store (per-project Claude memory ids)
sessions/
*.session

# Codex/Claude config backups
*.bak
*.bak_*
config.toml

# OS / editor cruft
.DS_Store
._*
*.swp
__pycache__/
*.pyc

# Per-project runtime board instances (created by init-collaboration.sh) — NOT repo content
collaboration.md
collaboration_signal.json
collaboration_state.json
collaboration_queue.json
collaboration_auto.log
collaboration_archive/
.watcher_*.state
.watcher_*.session
.qagent_*.session
.heartbeat_*.state
collaboration.lock
collaboration_participants.json

# Coordination layer (runtime, per-project) — entire dir
.collab/

# Codex/CMUX agent skills that land in the repo root (e.g. cmux-direct-execution) —
# kept on disk for Codex to use, but NOT part of this repo (the bridge's skill is skill/).
/skills/

# Subagent-driven-development process scratch (local)
.superpowers/

# EC1/EC3 identity — never commit private signing keys
.claude-bridge/keys/
*.key
!*.pub

# Claude Code local artifacts (worktrees etc) — not repo content
.claude/
