# Published contents are an allowlist (package.json "files"); this also strips junk
# from inside included dirs (e.g. scripts/__pycache__) and never ships tests or the
# per-project runtime board.
__pycache__/
*.pyc
*.bak
._*
tests/
sessions/
.collab/
collaboration.md
collaboration_*.json
collaboration.lock
.bridge_push.lock
DESIGN_*.md

# Internal design + maintainer docs — not shipped to end users (v0.9.0 packaging, C10)
docs/superpowers/
docs/github-promotion-plan.md
docs/github-directory-targets.md
docs/github-launch-commands.md
docs/collaboration-platform-diagnosis-*.md
docs/release-notes-v*.md
